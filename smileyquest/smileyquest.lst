000000r 1               ;--------------------------------------------------------------------;
000000r 1               ; VIC-20 Smiley Quest                                                ;
000000r 1               ;--------------------------------------------------------------------;
000000r 1               ; A tiny three-state game:
000000r 1               ;
000000r 1               ;   STATE_START    -> press fire to begin
000000r 1               ;   STATE_GAME     -> steer the smiley, don't touch a red X
000000r 1               ;   STATE_GAMEOVER -> press fire to go back to the title screen
000000r 1               ;
000000r 1               ; Everything below the main loop lives in the included files. The loop
000000r 1               ; itself never mentions a state by name - it just samples the joystick
000000r 1               ; and asks the state machine to run whatever state we're currently in.
000000r 1               
000000r 1               .include "../vic20.inc"
000000r 2               ; VIC-20 Include File for ca65
000000r 2               ; Memory addresses, KERNAL routines, and hardware registers
000000r 2               ; Compatible with both NTSC and PAL VIC-20 systems
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Zero Page Locations
000000r 2               ;=============================================================================
000000r 2               VARTAB          = $2D           ; Pointer to start of BASIC variables
000000r 2               ARYTAB          = $2F           ; Pointer to start of BASIC arrays
000000r 2               STREND          = $31           ; Pointer to end of BASIC arrays
000000r 2               FRETOP          = $33           ; Pointer to bottom of string space
000000r 2               MEMSIZ          = $37           ; Pointer to top of BASIC memory
000000r 2               TIME            = $A0           ; Jiffy clock (3 bytes)
000000r 2               TIMER           = $A0           ; Same as TIME
000000r 2               STATUS          = $90           ; I/O status byte
000000r 2               STKEY           = $91           ; STOP key flag
000000r 2               MSGFLG          = $9D           ; Kernal message control flag
000000r 2               FNLEN           = $B7           ; Length of filename
000000r 2               LA              = $B8           ; Logical file number
000000r 2               SA              = $B9           ; Secondary address
000000r 2               FA              = $BA           ; Device number
000000r 2               FNADR           = $BB           ; Pointer to filename (2 bytes)
000000r 2               STAL            = $C1           ; Pointer for tape I/O (2 bytes)
000000r 2               EAL             = $C3           ; Pointer for tape I/O (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Screen and Color Memory (Unexpanded VIC-20)
000000r 2               ;=============================================================================
000000r 2               SCREEN          = $1E00         ; Screen memory start (22x23 default)
000000r 2               COLRAM          = $9600         ; Color RAM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; User BASIC Memory
000000r 2               ;=============================================================================
000000r 2               BASIC_START     = $1001         ; Start of BASIC program area
000000r 2               BASIC_END       = $1E00         ; End of BASIC (screen memory starts)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIC Chip Registers (6560/6561 Video Interface Chip)
000000r 2               ;=============================================================================
000000r 2               VIC             = $9000         ; Base address of VIC chip
000000r 2               
000000r 2               ; Individual VIC registers
000000r 2               VIC_CR0         = $9000         ; Horizontal centering (bit 7 = interlace)
000000r 2               VIC_CR1         = $9001         ; Vertical centering
000000r 2               VIC_CR2         = $9002         ; Video matrix columns (bits 0-6, bit 7=raster)
000000r 2               VIC_CR3         = $9003         ; Raster value (bits 1-7 = rows*2, bit 0=character size)
000000r 2               VIC_CR4         = $9004         ; TV raster beam location (read only)
000000r 2               VIC_CR5         = $9005         ; Video matrix start address (bits 4-7)
000000r 2               VIC_CRA         = $900A         ; Bass frequency
000000r 2               VIC_CRB         = $900B         ; Alto frequency
000000r 2               VIC_CRC         = $900C         ; Soprano frequency
000000r 2               VIC_CRD         = $900D         ; Noise frequency
000000r 2               VIC_CRE         = $900E         ; Auxiliary color / Volume
000000r 2               VIC_CRF         = $900F         ; Screen & border colors / reverse mode
000000r 2               
000000r 2               ; VIC register aliases
000000r 2               VIC_HORZ        = VIC_CR0       ; Horizontal position
000000r 2               VIC_VERT        = VIC_CR1       ; Vertical position
000000r 2               VIC_COLUMNS     = VIC_CR2       ; Number of columns
000000r 2               VIC_ROWS        = VIC_CR3       ; Number of rows
000000r 2               VIC_RASTER      = VIC_CR4       ; Raster position
000000r 2               VIC_ORIGIN      = VIC_CR5       ; Screen memory location
000000r 2               VIC_BASS        = VIC_CRA       ; Sound: Bass voice
000000r 2               VIC_ALTO        = VIC_CRB       ; Sound: Alto voice
000000r 2               VIC_SOPRANO     = VIC_CRC       ; Sound: Soprano voice
000000r 2               VIC_NOISE       = VIC_CRD       ; Sound: Noise voice
000000r 2               VIC_VOLUME      = VIC_CRE       ; Volume control (bits 0-3)
000000r 2               VIC_AUX_COLOR   = VIC_CRE       ; Auxiliary color (bits 4-7)
000000r 2               VIC_BACKGROUND  = VIC_CRF       ; Background color (bits 4-7)
000000r 2               VIC_BORDER      = VIC_CRF       ; Border color (bits 0-2)
000000r 2               VIC_REVERSE     = VIC_CRF       ; Reverse mode (bit 3)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #1 Registers (6522 VIA - Keyboard, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA1            = $9110         ; Base address of VIA1
000000r 2               VIA1_PB         = $9110         ; Port B (keyboard row select, joystick)
000000r 2               VIA1_PA1        = $9111         ; Port A (keyboard column read)
000000r 2               VIA1_DDRB       = $9112         ; Data direction register B
000000r 2               VIA1_DDRA       = $9113         ; Data direction register A
000000r 2               VIA1_T1CL       = $9114         ; Timer 1 counter low
000000r 2               VIA1_T1CH       = $9115         ; Timer 1 counter high
000000r 2               VIA1_T1LL       = $9116         ; Timer 1 latch low
000000r 2               VIA1_T1LH       = $9117         ; Timer 1 latch high
000000r 2               VIA1_T2CL       = $9118         ; Timer 2 counter low
000000r 2               VIA1_T2CH       = $9119         ; Timer 2 counter high
000000r 2               VIA1_SR         = $911A         ; Shift register
000000r 2               VIA1_ACR        = $911B         ; Auxiliary control register
000000r 2               VIA1_PCR        = $911C         ; Peripheral control register
000000r 2               VIA1_IFR        = $911D         ; Interrupt flag register
000000r 2               VIA1_IER        = $911E         ; Interrupt enable register
000000r 2               VIA1_PA2        = $911F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #2 Registers (6522 VIA - Serial, Tape, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA2            = $9120         ; Base address of VIA2
000000r 2               VIA2_PB         = $9120         ; Port B (serial bus, tape control, joystick)
000000r 2               VIA2_PA1        = $9121         ; Port A (serial bus)
000000r 2               VIA2_DDRB       = $9122         ; Data direction register B
000000r 2               VIA2_DDRA       = $9123         ; Data direction register A
000000r 2               VIA2_T1CL       = $9124         ; Timer 1 counter low
000000r 2               VIA2_T1CH       = $9125         ; Timer 1 counter high
000000r 2               VIA2_T1LL       = $9126         ; Timer 1 latch low
000000r 2               VIA2_T1LH       = $9127         ; Timer 1 latch high
000000r 2               VIA2_T2CL       = $9128         ; Timer 2 counter low
000000r 2               VIA2_T2CH       = $9129         ; Timer 2 counter high
000000r 2               VIA2_SR         = $912A         ; Shift register
000000r 2               VIA2_ACR        = $912B         ; Auxiliary control register
000000r 2               VIA2_PCR        = $912C         ; Peripheral control register
000000r 2               VIA2_IFR        = $912D         ; Interrupt flag register
000000r 2               VIA2_IER        = $912E         ; Interrupt enable register
000000r 2               VIA2_PA2        = $912F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Joystick (VIA1 Port A = $9111, VIA2 Port B = $9120)
000000r 2               ; Active-low: bit is 0 when the switch is closed (direction/fire pressed)
000000r 2               ;=============================================================================
000000r 2               JOY_UP          = %00000100     ; VIA1_PA1 bit 2
000000r 2               JOY_DOWN        = %00001000     ; VIA1_PA1 bit 3
000000r 2               JOY_LEFT        = %00010000     ; VIA1_PA1 bit 4
000000r 2               JOY_FIRE        = %00100000     ; VIA1_PA1 bit 5
000000r 2               JOY_RIGHT       = %10000000     ; VIA2_PB bit 7
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Color Codes
000000r 2               ;=============================================================================
000000r 2               BLACK           = $00
000000r 2               WHITE           = $01
000000r 2               RED             = $02
000000r 2               CYAN            = $03
000000r 2               PURPLE          = $04
000000r 2               GREEN           = $05
000000r 2               BLUE            = $06
000000r 2               YELLOW          = $07
000000r 2               ORANGE          = $08
000000r 2               LIGHT_ORANGE    = $09
000000r 2               PINK            = $0A
000000r 2               LIGHT_CYAN      = $0B
000000r 2               LIGHT_PURPLE    = $0C
000000r 2               LIGHT_GREEN     = $0D
000000r 2               LIGHT_BLUE      = $0E
000000r 2               LIGHT_YELLOW    = $0F
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Character Codes (PETSCII)
000000r 2               ;=============================================================================
000000r 2               CHR_RETURN      = $0D
000000r 2               CHR_SPACE       = $20
000000r 2               CHR_DELETE      = $14
000000r 2               CHR_INSERT      = $94
000000r 2               CHR_HOME        = $13
000000r 2               CHR_CLEAR       = $93
000000r 2               CHR_RVSON       = $12           ; Reverse on
000000r 2               CHR_RVSOFF      = $92           ; Reverse off
000000r 2               CHR_DOWN        = $11
000000r 2               CHR_UP          = $91
000000r 2               CHR_RIGHT       = $1D
000000r 2               CHR_LEFT        = $9D
000000r 2               CHR_BLACK       = $90
000000r 2               CHR_WHITE       = $05
000000r 2               CHR_RED         = $1C
000000r 2               CHR_CYAN        = $9F
000000r 2               CHR_PURPLE      = $9C
000000r 2               CHR_GREEN       = $1E
000000r 2               CHR_BLUE        = $9E
000000r 2               CHR_YELLOW      = $9B
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; ROM Addresses
000000r 2               ;=============================================================================
000000r 2               CHARROM         = $8000         ; Character ROM
000000r 2               BASIC_ROM       = $C000         ; BASIC ROM start
000000r 2               KERNAL_ROM      = $E000         ; KERNAL ROM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; KERNAL Routines
000000r 2               ;=============================================================================
000000r 2               ; Internal KERNAL routines (address may vary by ROM version)
000000r 2               CINT            = $E518         ; Initialize screen editor
000000r 2               IOINIT          = $FDF9         ; Initialize I/O
000000r 2               RAMTAS          = $FD8D         ; Initialize RAM
000000r 2               RESTOR          = $FD52         ; Restore default I/O vectors
000000r 2               VECTOR          = $FD1A         ; Manage RAM vectors
000000r 2               
000000r 2               ; KERNAL Jump Table (standard across all VIC-20s)
000000r 2               SETMSG          = $FF90         ; Control KERNAL messages
000000r 2               SECOND          = $FF93         ; Send secondary address
000000r 2               TKSA            = $FF96         ; Send secondary address for talk
000000r 2               MEMTOP          = $FF99         ; Read/set top of memory
000000r 2               MEMBOT          = $FF9C         ; Read/set bottom of memory
000000r 2               SCNKEY          = $FF9F         ; Scan keyboard
000000r 2               SETTMO          = $FFA2         ; Set timeout for serial bus
000000r 2               ACPTR           = $FFA5         ; Input byte from serial bus
000000r 2               CIOUT           = $FFA8         ; Output byte to serial bus
000000r 2               UNTLK           = $FFAB         ; Send UNTALK to serial bus
000000r 2               UNLSN           = $FFAE         ; Send UNLISTEN to serial bus
000000r 2               LISTEN          = $FFB1         ; Send LISTEN to serial bus
000000r 2               TALK            = $FFB4         ; Send TALK to serial bus
000000r 2               READST          = $FFB7         ; Read I/O status word
000000r 2               SETLFS          = $FFBA         ; Set logical file parameters
000000r 2               SETNAM          = $FFBD         ; Set filename
000000r 2               OPEN            = $FFC0         ; Open a logical file
000000r 2               CLOSE           = $FFC3         ; Close a logical file
000000r 2               CHKIN           = $FFC6         ; Define file as default input
000000r 2               CHKOUT          = $FFC9         ; Define file as default output
000000r 2               CLRCHN          = $FFCC         ; Restore default I/O devices
000000r 2               CHRIN           = $FFCF         ; Input character from channel
000000r 2               CHROUT          = $FFD2         ; Output character to channel
000000r 2               LOAD            = $FFD5         ; Load RAM from device
000000r 2               SAVE            = $FFD8         ; Save RAM to device
000000r 2               SETTIM          = $FFDB         ; Set 24-hour clock
000000r 2               RDTIM           = $FFDE         ; Read 24-hour clock
000000r 2               STOP            = $FFE1         ; Check STOP key
000000r 2               GETIN           = $FFE4         ; Get character from keyboard
000000r 2               CLALL           = $FFE7         ; Close all channels and files
000000r 2               UDTIM           = $FFEA         ; Increment 24-hour clock
000000r 2               SCREEN_ORG      = $FFED         ; Return screen organization
000000r 2               PLOT            = $FFF0         ; Read/set cursor X/Y position
000000r 2               IOBASE          = $FFF3         ; Return I/O base address
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; IRQ/NMI Vectors
000000r 2               ;=============================================================================
000000r 2               IRQ_VECTOR      = $0314         ; IRQ vector (2 bytes)
000000r 2               BRK_VECTOR      = $0316         ; BRK vector (2 bytes)
000000r 2               NMI_VECTOR      = $0318         ; NMI vector (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Hardware Vectors (in ROM)
000000r 2               ;=============================================================================
000000r 2               HW_NMI          = $FFFA         ; NMI vector
000000r 2               HW_RESET        = $FFFC         ; Reset vector
000000r 2               HW_IRQ          = $FFFE         ; IRQ/BRK vector
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Useful Constants
000000r 2               ;=============================================================================
000000r 2               SCREEN_COLS     = 22            ; Default screen columns
000000r 2               SCREEN_ROWS     = 23            ; Default screen rows
000000r 2               JIFFY_PAL       = 50            ; Jiffies per second (PAL)
000000r 2               JIFFY_NTSC      = 60            ; Jiffies per second (NTSC)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Memory Expansion Configurations
000000r 2               ;=============================================================================
000000r 2               ; RAM Block 0 (BLK0) = $0400-$0FFF (3K)
000000r 2               ; RAM Block 1 (BLK1) = $2000-$3FFF (8K)
000000r 2               ; RAM Block 2 (BLK2) = $4000-$5FFF (8K)
000000r 2               ; RAM Block 3 (BLK3) = $6000-$7FFF (8K)
000000r 2               ; RAM Block 5 (BLK5) = $A000-$BFFF (8K)
000000r 2               
000000r 2               BLK0            = $0400         ; 3K expansion
000000r 2               BLK1            = $2000         ; 8K expansion
000000r 2               BLK2            = $4000         ; 8K expansion
000000r 2               BLK3            = $6000         ; 8K expansion
000000r 2               BLK5            = $A000         ; 8K expansion
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; End of VIC20.inc
000000r 2               ;=============================================================================
000000r 2               
000000r 1               
000000r 1               .segment "CART"
000000r 1               
000000r 1               .include "defs.asm"          ; memory map, constants, macros
000000r 2               ;--------------------------------------------------------------------;
000000r 2               ; Definitions - memory map, shared constants, helper macros           ;
000000r 2               ;--------------------------------------------------------------------;
000000r 2               
000000r 2               ;=====================================================================;
000000r 2               ; Zero page                                                           ;
000000r 2               ;=====================================================================;
000000r 2               ; Only pointers really need to live down here: the 6502 can only do
000000r 2               ; indirect addressing - lda (PTR),y - through zero page. $F7-$FE are
000000r 2               ; free on the VIC-20 as long as we don't use the RS-232 port.
000000r 2               
000000r 2               TBL_PTR   = $F7             ; 2 bytes, address of a state dispatch table
000000r 2               TXT_PTR   = $F9             ; 2 bytes, address of a string to print
000000r 2               CHAR_PTR  = $FB             ; 2 bytes, screen/colour RAM pointer
000000r 2               JMP_PTR   = $FD             ; 2 bytes, address of the handler to jump to
000000r 2               
000000r 2               ;=====================================================================;
000000r 2               ; Game variables                                                      ;
000000r 2               ;=====================================================================;
000000r 2               ; The cassette buffer at $033C is 192 bytes of RAM nothing else wants
000000r 2               ; (we never touch the tape), so it makes a tidy home for game state.
000000r 2               
000000r 2               GAME_STATE = $033C          ; 1 byte, which state we're currently in
000000r 2               PLAYER_X   = $033D          ; 1 byte, player column (0-21)
000000r 2               PLAYER_Y   = $033E          ; 1 byte, player row (0-22)
000000r 2               PREV_X     = $033F          ; 1 byte, column the player was last drawn at
000000r 2               PREV_Y     = $0340          ; 1 byte, row the player was last drawn at
000000r 2               JOY_NOW    = $0341          ; 1 byte, switches held this pass (1 = pressed)
000000r 2               JOY_PREV   = $0342          ; 1 byte, switches held on the previous pass
000000r 2               JOY_EDGE   = $0343          ; 1 byte, switches newly pressed this pass
000000r 2               DRAW_COLOR = $0344          ; 1 byte, colour DrawCell paints with
000000r 2               HAZ_INDEX  = $0345          ; 1 byte, loop counter for walking the hazards
000000r 2               
000000r 2               ;=====================================================================;
000000r 2               ; Characters                                                          ;
000000r 2               ;=====================================================================;
000000r 2               ; Screen codes. 0-63 come from the ROM font we copy into RAM (1-26 are
000000r 2               ; the letters, 32 is a blank, 48-57 the digits); 60 and 61 are slots we
000000r 2               ; overwrite with our own glyphs since we never print "<" or "=".
000000r 2               
000000r 2               CHAR_BLANK  = 32
000000r 2               CHAR_PLAYER = 60            ; smiley
000000r 2               CHAR_HAZARD = 61            ; the deadly X
000000r 2               
000000r 2               ;=====================================================================;
000000r 2               ; Playfield                                                           ;
000000r 2               ;=====================================================================;
000000r 2               ; Row 0 and 1 are reserved for the status line, so the player is
000000r 2               ; fenced out of them.
000000r 2               
000000r 2               PLAY_TOP    = 2
000000r 2               PLAY_BOTTOM = SCREEN_ROWS-1 ; 22
000000r 2               PLAY_LEFT   = 0
000000r 2               PLAY_RIGHT  = SCREEN_COLS-1 ; 21
000000r 2               
000000r 2               START_X     = 10            ; where the player spawns
000000r 2               START_Y     = 12
000000r 2               
000000r 2               ;=====================================================================;
000000r 2               ; Text encoding                                                       ;
000000r 2               ;=====================================================================;
000000r 2               ; Screen RAM doesn't hold ASCII, it holds screen codes: "A" is 1, not
000000r 2               ; 65. .charmap tells the assembler how to translate the characters in
000000r 2               ; a .byte "..." string, so we can write text normally in the source and
000000r 2               ; still get bytes we can poke straight into screen RAM.
000000r 2               
000000r 2               .repeat 32, i
000000r 2                 .charmap $20+i, $20+i     ; space, digits and punctuation pass through
000000r 2               .endrepeat
000000r 2               
000000r 2               .repeat 26, i
000000r 2                 .charmap $41+i, $01+i     ; "A".."Z" -> 1..26
000000r 2                 .charmap $61+i, $01+i     ; lower case lands on the same glyphs
000000r 2               .endrepeat
000000r 2               
000000r 2               ;=====================================================================;
000000r 2               ; Macros                                                              ;
000000r 2               ;=====================================================================;
000000r 2               
000000r 2               ; Prints a null-terminated string at a cell. Just sugar over
000000r 2               ; PrintString so the screen-drawing code reads like a list of lines.
000000r 2               .macro PrintAt Text, Col, Row
000000r 2                 lda #<Text
000000r 2                 sta TXT_PTR
000000r 2                 lda #>Text
000000r 2                 sta TXT_PTR+1
000000r 2                 ldx #Col
000000r 2                 ldy #Row
000000r 2                 jsr PrintString
000000r 2               .endmacro
000000r 2               
000000r 1               
000000r 1               ; Cart Header
000000r 1  rr rr        .addr ColdStart              ; Cold start vector
000002r 1  rr rr        .addr ColdStart              ; Warm start vector (RESTORE = full restart)
000004r 1  41 30 C3 C2  .byte $41,$30,$C3,$C2,$CD    ; Cartridge signature (A0CBM)
000008r 1  CD           
000009r 1               
000009r 1               ; Cold Start
000009r 1               ColdStart:
000009r 1  78             sei                        ; Disable interrupts
00000Ar 1  D8             cld                        ; Clear decimal mode
00000Br 1  A2 FF          ldx #$FF                   ; Set stack pointer to $FF
00000Dr 1  9A             txs
00000Er 1  20 8D FD       jsr RAMTAS                 ; Initialize RAM, set BASIC pointers
000011r 1  20 52 FD       jsr RESTOR                 ; Restore default I/O vectors
000014r 1  20 F9 FD       jsr IOINIT                 ; Initialize I/O chips
000017r 1  20 18 E5       jsr CINT                   ; Initialize screen editor
00001Ar 1  58             cli                        ; NMI warm entry arrives with I set
00001Br 1               
00001Br 1  A9 08          lda #8
00001Dr 1  8D 0F 90       sta VIC_CRF                ; Set background and border to black
000020r 1               
000020r 1  20 rr rr       jsr LoadCharacters         ; Build our character set in RAM
000023r 1               
000023r 1  A9 00          lda #0
000025r 1  8D 41 03       sta JOY_NOW                ; No switches held yet
000028r 1               
000028r 1  A9 00          lda #STATE_START
00002Ar 1  20 rr rr       jsr ChangeState            ; Enter the title screen
00002Dr 1               
00002Dr 1               ;--------------------------------------------------------------------;
00002Dr 1               ; The main loop                                                       ;
00002Dr 1               ;--------------------------------------------------------------------;
00002Dr 1               MainLoop:
00002Dr 1  20 rr rr       jsr ReadJoystick           ; Sample the stick into JOY_NOW / JOY_EDGE
000030r 1  20 rr rr       jsr UpdateState            ; Run the current state's update routine
000033r 1  4C rr rr       jmp MainLoop
000036r 1               
000036r 1               ;--------------------------------------------------------------------;
000036r 1               ; Everything else                                                     ;
000036r 1               ;--------------------------------------------------------------------;
000036r 1               .include "state.asm"         ; ChangeState / UpdateState and the tables
000036r 2               ;--------------------------------------------------------------------;
000036r 2               ; State machine                                                       ;
000036r 2               ;--------------------------------------------------------------------;
000036r 2               ; The game is always in exactly one state, and GAME_STATE holds which.
000036r 2               ;
000036r 2               ; Every state supplies two routines:
000036r 2               ;
000036r 2               ;   enter  - runs once, the moment we switch into the state. Draws the
000036r 2               ;            state's screen and sets up whatever it needs.
000036r 2               ;   update - runs once per pass of the main loop, for as long as we
000036r 2               ;            stay in the state.
000036r 2               ;
000036r 2               ; The two tables below list those routines in state-id order, so the
000036r 2               ; id doubles as an index into them. Switching states is then just
000036r 2               ; "store the new id, then call its enter routine", and the main loop
000036r 2               ; never has to know which state it's running.
000036r 2               
000036r 2               STATE_START    = 0
000036r 2               STATE_GAME     = 1
000036r 2               STATE_GAMEOVER = 2
000036r 2               
000036r 2               StateEnterTable:
000036r 2  rr rr          .addr StartEnter          ; STATE_START
000038r 2  rr rr          .addr GameEnter           ; STATE_GAME
00003Ar 2  rr rr          .addr GameOverEnter       ; STATE_GAMEOVER
00003Cr 2               
00003Cr 2               StateUpdateTable:
00003Cr 2  rr rr          .addr StartUpdate         ; STATE_START
00003Er 2  rr rr          .addr GameUpdate          ; STATE_GAME
000040r 2  rr rr          .addr GameOverUpdate      ; STATE_GAMEOVER
000042r 2               
000042r 2               ; Switches to a new state and immediately runs its enter routine.
000042r 2               ; In: A = state id
000042r 2               ChangeState:
000042r 2  8D 3C 03       sta GAME_STATE
000045r 2  A2 rr          ldx #<StateEnterTable
000047r 2  A0 rr          ldy #>StateEnterTable
000049r 2  4C rr rr       jmp CallHandler
00004Cr 2               
00004Cr 2               ; Runs the current state's update routine. The main loop calls this
00004Cr 2               ; once per pass and nothing else.
00004Cr 2               UpdateState:
00004Cr 2  A2 rr          ldx #<StateUpdateTable
00004Er 2  A0 rr          ldy #>StateUpdateTable
000050r 2  4C rr rr       jmp CallHandler
000053r 2               
000053r 2               ; Looks the current state's handler up in a table of addresses and
000053r 2               ; jumps to it. Because we jump rather than jsr, the handler's own rts
000053r 2               ; returns straight to whoever called ChangeState/UpdateState.
000053r 2               ; In: X/Y = low/high byte of the table address
000053r 2               CallHandler:
000053r 2  86 F7          stx TBL_PTR
000055r 2  84 F8          sty TBL_PTR+1
000057r 2  AD 3C 03       lda GAME_STATE
00005Ar 2  0A             asl a                     ; two bytes per entry, so id*2 is the offset
00005Br 2  A8             tay
00005Cr 2  B1 F7          lda (TBL_PTR),y
00005Er 2  85 FD          sta JMP_PTR               ; low byte of the handler address
000060r 2  C8             iny
000061r 2  B1 F7          lda (TBL_PTR),y
000063r 2  85 FE          sta JMP_PTR+1             ; high byte
000065r 2  6C FD 00       jmp (JMP_PTR)
000068r 2               
000068r 1               .include "start.asm"         ; STATE_START handlers
000068r 2               ;--------------------------------------------------------------------;
000068r 2               ; STATE_START - the title screen                                      ;
000068r 2               ;--------------------------------------------------------------------;
000068r 2               
000068r 2               ; Draws the title screen.
000068r 2               StartEnter:
000068r 2  20 rr rr       jsr ClearScreen
00006Br 2  A9 01          lda #WHITE
00006Dr 2  20 rr rr       jsr ClearColors
000070r 2               
000070r 2  A9 rr 85 F9    PrintAt StartTitleText,  5,  8
000074r 2  A9 rr 85 FA  
000078r 2  A2 05 A0 08  
00007Fr 2  A9 rr 85 F9    PrintAt StartPromptText, 6, 12
000083r 2  A9 rr 85 FA  
000087r 2  A2 06 A0 0C  
00008Er 2  A9 rr 85 F9    PrintAt StartStartText,  7, 14
000092r 2  A9 rr 85 FA  
000096r 2  A2 07 A0 0E  
00009Dr 2  60             rts
00009Er 2               
00009Er 2               ; Waits for the fire button, then hands over to the game.
00009Er 2               StartUpdate:
00009Er 2  AD 43 03       lda JOY_EDGE
0000A1r 2  29 20          and #JOY_FIRE
0000A3r 2  F0 05          beq @Done                 ; fire not newly pressed, keep waiting
0000A5r 2               
0000A5r 2  A9 01          lda #STATE_GAME
0000A7r 2  20 rr rr       jsr ChangeState
0000AAr 2               @Done:
0000AAr 2  60             rts
0000ABr 2               
0000ABr 2               StartTitleText:
0000ABr 2  13 0D 09 0C    .byte "SMILEY QUEST", 0
0000AFr 2  05 19 20 11  
0000B3r 2  15 05 13 14  
0000B8r 2               StartPromptText:
0000B8r 2  10 12 05 13    .byte "PRESS FIRE", 0
0000BCr 2  13 20 06 09  
0000C0r 2  12 05 00     
0000C3r 2               StartStartText:
0000C3r 2  14 0F 20 13    .byte "TO START", 0
0000C7r 2  14 01 12 14  
0000CBr 2  00           
0000CCr 2               
0000CCr 1               .include "game.asm"          ; STATE_GAME handlers
0000CCr 2               ;--------------------------------------------------------------------;
0000CCr 2               ; STATE_GAME - move the smiley, don't touch an X                      ;
0000CCr 2               ;--------------------------------------------------------------------;
0000CCr 2               
0000CCr 2               ; Sets up a fresh game: draws the playfield, puts the player back at
0000CCr 2               ; the spawn point.
0000CCr 2               GameEnter:
0000CCr 2  20 rr rr       jsr ClearScreen
0000CFr 2  A9 07          lda #YELLOW
0000D1r 2  20 rr rr       jsr ClearColors
0000D4r 2               
0000D4r 2  A9 rr 85 F9    PrintAt GameTitleText, 5, 0
0000D8r 2  A9 rr 85 FA  
0000DCr 2  A2 05 A0 00  
0000E3r 2               
0000E3r 2  A9 0A          lda #START_X
0000E5r 2  8D 3D 03       sta PLAYER_X
0000E8r 2  8D 3F 03       sta PREV_X
0000EBr 2  A9 0C          lda #START_Y
0000EDr 2  8D 3E 03       sta PLAYER_Y
0000F0r 2  8D 40 03       sta PREV_Y                ; nothing drawn yet, so "previous" is here too
0000F3r 2               
0000F3r 2  20 rr rr       jsr DrawHazards
0000F6r 2  20 rr rr       jsr DrawPlayer
0000F9r 2  60             rts
0000FAr 2               
0000FAr 2               ; One pass of the game: read the stick, redraw, then see if we died.
0000FAr 2               GameUpdate:
0000FAr 2  20 rr rr       jsr MovePlayer            ; joystick edges -> PLAYER_X / PLAYER_Y
0000FDr 2  20 rr rr       jsr UpdatePlayer          ; blank the old cell, draw the new one
000100r 2  20 rr rr       jsr CheckHazards          ; standing on an X? then it's game over
000103r 2  60             rts
000104r 2               
000104r 2               ; Moves the player one cell per direction press. JOY_EDGE only has a
000104r 2               ; bit set on the pass where a switch goes from released to pressed, so
000104r 2               ; holding the stick doesn't run the player off the screen.
000104r 2               MovePlayer:
000104r 2  AD 43 03       lda JOY_EDGE
000107r 2  29 04          and #JOY_UP
000109r 2  F0 0A          beq @NotUp
00010Br 2  AD 3E 03       lda PLAYER_Y
00010Er 2  C9 02          cmp #PLAY_TOP
000110r 2  F0 03          beq @NotUp                ; already on the top row
000112r 2  CE 3E 03       dec PLAYER_Y
000115r 2               @NotUp:
000115r 2               
000115r 2  AD 43 03       lda JOY_EDGE
000118r 2  29 08          and #JOY_DOWN
00011Ar 2  F0 0A          beq @NotDown
00011Cr 2  AD 3E 03       lda PLAYER_Y
00011Fr 2  C9 16          cmp #PLAY_BOTTOM
000121r 2  F0 03          beq @NotDown              ; already on the bottom row
000123r 2  EE 3E 03       inc PLAYER_Y
000126r 2               @NotDown:
000126r 2               
000126r 2  AD 43 03       lda JOY_EDGE
000129r 2  29 10          and #JOY_LEFT
00012Br 2  F0 0A          beq @NotLeft
00012Dr 2  AD 3D 03       lda PLAYER_X
000130r 2  C9 00          cmp #PLAY_LEFT
000132r 2  F0 03          beq @NotLeft              ; already in the leftmost column
000134r 2  CE 3D 03       dec PLAYER_X
000137r 2               @NotLeft:
000137r 2               
000137r 2  AD 43 03       lda JOY_EDGE
00013Ar 2  29 80          and #JOY_RIGHT
00013Cr 2  F0 0A          beq @NotRight
00013Er 2  AD 3D 03       lda PLAYER_X
000141r 2  C9 15          cmp #PLAY_RIGHT
000143r 2  F0 03          beq @NotRight             ; already in the rightmost column
000145r 2  EE 3D 03       inc PLAYER_X
000148r 2               @NotRight:
000148r 2  60             rts
000149r 2               
000149r 2               ; Draws the player at their current cell.
000149r 2               DrawPlayer:
000149r 2  A9 07          lda #YELLOW
00014Br 2  8D 44 03       sta DRAW_COLOR
00014Er 2  AE 3D 03       ldx PLAYER_X
000151r 2  AC 3E 03       ldy PLAYER_Y
000154r 2  A9 3C          lda #CHAR_PLAYER
000156r 2  4C rr rr       jmp DrawCell              ; DrawCell's rts returns for us
000159r 2               
000159r 2               ; Redraws the player, but only if they actually moved - otherwise we'd
000159r 2               ; be rewriting the same two cells thousands of times a second.
000159r 2               UpdatePlayer:
000159r 2  AD 3D 03       lda PLAYER_X
00015Cr 2  CD 3F 03       cmp PREV_X
00015Fr 2  D0 08          bne @Moved
000161r 2  AD 3E 03       lda PLAYER_Y
000164r 2  CD 40 03       cmp PREV_Y
000167r 2  F0 1F          beq @Done                 ; same cell as last pass, leave the screen alone
000169r 2               @Moved:
000169r 2  A9 00          lda #BLACK
00016Br 2  8D 44 03       sta DRAW_COLOR
00016Er 2  AE 3F 03       ldx PREV_X
000171r 2  AC 40 03       ldy PREV_Y
000174r 2  A9 20          lda #CHAR_BLANK
000176r 2  20 rr rr       jsr DrawCell              ; blank the cell the player left
000179r 2               
000179r 2  20 rr rr       jsr DrawPlayer            ; draw them at the cell they moved to
00017Cr 2               
00017Cr 2  AD 3D 03       lda PLAYER_X
00017Fr 2  8D 3F 03       sta PREV_X
000182r 2  AD 3E 03       lda PLAYER_Y
000185r 2  8D 40 03       sta PREV_Y                ; remember where we drew them
000188r 2               @Done:
000188r 2  60             rts
000189r 2               
000189r 2               ; Paints every hazard in the table.
000189r 2               DrawHazards:
000189r 2  A9 02          lda #RED
00018Br 2  8D 44 03       sta DRAW_COLOR
00018Er 2  A2 00          ldx #0
000190r 2               @Loop:
000190r 2  8E 45 03       stx HAZ_INDEX             ; DrawCell needs X for the column, so stash it
000193r 2  BC rr rr       ldy HazardTable+1,x       ; row
000196r 2  BD rr rr       lda HazardTable,x         ; column
000199r 2  AA             tax
00019Ar 2  A9 3D          lda #CHAR_HAZARD
00019Cr 2  20 rr rr       jsr DrawCell
00019Fr 2               
00019Fr 2  AE 45 03       ldx HAZ_INDEX
0001A2r 2  E8             inx
0001A3r 2  E8             inx                       ; two bytes per hazard
0001A4r 2  E0 10          cpx #HAZARD_COUNT*2
0001A6r 2  D0 E8          bne @Loop
0001A8r 2  60             rts
0001A9r 2               
0001A9r 2               ; Compares the player's cell against every hazard, and ends the game on
0001A9r 2               ; a match.
0001A9r 2               CheckHazards:
0001A9r 2  A2 00          ldx #0
0001ABr 2               @Loop:
0001ABr 2  BD rr rr       lda HazardTable,x
0001AEr 2  CD 3D 03       cmp PLAYER_X
0001B1r 2  D0 08          bne @Next                 ; different column, can't be a hit
0001B3r 2  BD rr rr       lda HazardTable+1,x
0001B6r 2  CD 3E 03       cmp PLAYER_Y
0001B9r 2  F0 07          beq @Hit
0001BBr 2               @Next:
0001BBr 2  E8             inx
0001BCr 2  E8             inx
0001BDr 2  E0 10          cpx #HAZARD_COUNT*2
0001BFr 2  D0 EA          bne @Loop
0001C1r 2  60             rts                       ; walked the whole table, still alive
0001C2r 2               
0001C2r 2               @Hit:
0001C2r 2  A9 02          lda #STATE_GAMEOVER
0001C4r 2  4C rr rr       jmp ChangeState           ; ChangeState's rts returns for us
0001C7r 2               
0001C7r 2               ; Where the deadly X's sit, as column/row pairs.
0001C7r 2               HazardTable:
0001C7r 2  04 05          .byte  4,  5
0001C9r 2  11 06          .byte 17,  6
0001CBr 2  09 09          .byte  9,  9
0001CDr 2  0F 0B          .byte 15, 11
0001CFr 2  02 0E          .byte  2, 14
0001D1r 2  0D 0F          .byte 13, 15
0001D3r 2  13 12          .byte 19, 18
0001D5r 2  07 14          .byte  7, 20
0001D7r 2               HAZARD_COUNT = (* - HazardTable) / 2
0001D7r 2               
0001D7r 2               GameTitleText:
0001D7r 2  01 16 0F 09    .byte "AVOID THE ", CHAR_HAZARD, 0
0001DBr 2  04 20 14 08  
0001DFr 2  05 20 3D 00  
0001E3r 2               
0001E3r 1               .include "gameover.asm"      ; STATE_GAMEOVER handlers
0001E3r 2               ;--------------------------------------------------------------------;
0001E3r 2               ; STATE_GAMEOVER - the "you touched an X" screen                      ;
0001E3r 2               ;--------------------------------------------------------------------;
0001E3r 2               
0001E3r 2               ; Draws the game over screen.
0001E3r 2               GameOverEnter:
0001E3r 2  20 rr rr       jsr ClearScreen
0001E6r 2  A9 02          lda #RED
0001E8r 2  20 rr rr       jsr ClearColors
0001EBr 2               
0001EBr 2  A9 rr 85 F9    PrintAt GameOverTitleText,  6,  9
0001EFr 2  A9 rr 85 FA  
0001F3r 2  A2 06 A0 09  
0001FAr 2  A9 rr 85 F9    PrintAt GameOverPromptText, 6, 12
0001FEr 2  A9 rr 85 FA  
000202r 2  A2 06 A0 0C  
000209r 2  A9 rr 85 F9    PrintAt GameOverBackText,   6, 14
00020Dr 2  A9 rr 85 FA  
000211r 2  A2 06 A0 0E  
000218r 2  60             rts
000219r 2               
000219r 2               ; Waits for the fire button, then goes back to the title screen.
000219r 2               GameOverUpdate:
000219r 2  AD 43 03       lda JOY_EDGE
00021Cr 2  29 20          and #JOY_FIRE
00021Er 2  F0 05          beq @Done                 ; fire not newly pressed, keep waiting
000220r 2               
000220r 2  A9 00          lda #STATE_START
000222r 2  20 rr rr       jsr ChangeState
000225r 2               @Done:
000225r 2  60             rts
000226r 2               
000226r 2               GameOverTitleText:
000226r 2  07 01 0D 05    .byte "GAME OVER", 0
00022Ar 2  20 0F 16 05  
00022Er 2  12 00        
000230r 2               GameOverPromptText:
000230r 2  10 12 05 13    .byte "PRESS FIRE", 0
000234r 2  13 20 06 09  
000238r 2  12 05 00     
00023Br 2               GameOverBackText:
00023Br 2  14 0F 20 12    .byte "TO RETURN", 0
00023Fr 2  05 14 15 12  
000243r 2  0E 00        
000245r 2               
000245r 1               .include "input.asm"         ; ReadJoystick
000245r 2               ;--------------------------------------------------------------------;
000245r 2               ; Input - joystick sampling                                           ;
000245r 2               ;--------------------------------------------------------------------;
000245r 2               
000245r 2               ; Samples the joystick once per main loop pass and boils it down to two
000245r 2               ; bytes the states can just AND against:
000245r 2               ;
000245r 2               ;   JOY_NOW  - switches held right now  (1 = pressed)
000245r 2               ;   JOY_EDGE - switches that went from released to pressed this pass
000245r 2               ;
000245r 2               ; The hardware reports switches active-low (0 = pressed) and spreads
000245r 2               ; them over two chips, so this routine flips the sense and merges them
000245r 2               ; into one byte using the JOY_* masks from vic20.inc. The masks don't
000245r 2               ; overlap - up/down/left/fire are bits 2-5 of VIA1, right is bit 7 of
000245r 2               ; VIA2 - so they coexist happily in a single byte.
000245r 2               ReadJoystick:
000245r 2  AD 41 03       lda JOY_NOW
000248r 2  8D 42 03       sta JOY_PREV              ; this pass's "now" is next pass's "previous"
00024Br 2               
00024Br 2  AD 11 91       lda VIA1_PA1              ; up, down, left and fire
00024Er 2  49 FF          eor #$FF                  ; flip active-low, so 1 now means pressed
000250r 2  29 3C          and #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_FIRE)
000252r 2  8D 41 03       sta JOY_NOW
000255r 2               
000255r 2                 ; Right lives on VIA2 and needs its DDR flipped to input first: VIA2's
000255r 2                 ; port B defaults to all-output (it also drives keyboard columns), so
000255r 2                 ; reading it normally just returns the last value we wrote, not the
000255r 2                 ; switch state. Flip bit 7 to input, read, then put it straight back
000255r 2                 ; or keyboard scanning breaks.
000255r 2  78             sei
000256r 2  A9 7F          lda #%01111111
000258r 2  8D 22 91       sta VIA2_DDRB
00025Br 2  AD 20 91       lda VIA2_PB
00025Er 2  48             pha
00025Fr 2  A9 FF          lda #%11111111
000261r 2  8D 22 91       sta VIA2_DDRB
000264r 2  58             cli
000265r 2  68             pla
000266r 2  49 FF          eor #$FF
000268r 2  29 80          and #JOY_RIGHT
00026Ar 2  0D 41 03       ora JOY_NOW
00026Dr 2  8D 41 03       sta JOY_NOW               ; all five switches now live in one byte
000270r 2               
000270r 2                 ; A switch is "newly pressed" when it's held now but wasn't before.
000270r 2  AD 42 03       lda JOY_PREV
000273r 2  49 FF          eor #$FF                  ; NOT previously held
000275r 2  2D 41 03       and JOY_NOW               ; AND held now
000278r 2  8D 43 03       sta JOY_EDGE
00027Br 2  60             rts
00027Cr 2               
00027Cr 1               .include "screen.asm"        ; ClearScreen, DrawCell, PrintString, ...
00027Cr 2               ;--------------------------------------------------------------------;
00027Cr 2               ; Screen - drawing primitives                                         ;
00027Cr 2               ;--------------------------------------------------------------------;
00027Cr 2               ; Screen RAM is 22x23 = 506 bytes at $1E00, and colour RAM shadows it
00027Cr 2               ; cell for cell at $9600. Same offset in both, so one address
00027Cr 2               ; calculation serves for both writes.
00027Cr 2               
00027Cr 2               ; Fills the whole screen with blanks. Two overlapping 256-byte passes
00027Cr 2               ; cover all 506 cells without needing a 16-bit counter.
00027Cr 2               ClearScreen:
00027Cr 2  A9 20          lda #CHAR_BLANK
00027Er 2  A2 00          ldx #0
000280r 2               @Loop:
000280r 2  9D 00 1E       sta SCREEN,x
000283r 2  9D FA 1E       sta SCREEN+250,x
000286r 2  E8             inx
000287r 2  D0 F7          bne @Loop
000289r 2  60             rts
00028Ar 2               
00028Ar 2               ; Paints every cell's colour, same trick.
00028Ar 2               ; In: A = colour
00028Ar 2               ClearColors:
00028Ar 2  A2 00          ldx #0
00028Cr 2               @Loop:
00028Cr 2  9D 00 96       sta COLRAM,x
00028Fr 2  9D FA 96       sta COLRAM+250,x
000292r 2  E8             inx
000293r 2  D0 F7          bne @Loop
000295r 2  60             rts
000296r 2               
000296r 2               ; Draws one character, in one colour, at one cell.
000296r 2               ; In: A = character code, X = column, Y = row, DRAW_COLOR = colour
000296r 2               DrawCell:
000296r 2  48             pha                       ; CalcScreenPtr needs X and Y, so park the char
000297r 2  20 rr rr       jsr CalcScreenPtr
00029Ar 2  68             pla
00029Br 2  A0 00          ldy #0
00029Dr 2  91 FB          sta (CHAR_PTR),y          ; screen RAM
00029Fr 2               
00029Fr 2  A5 FC          lda CHAR_PTR+1
0002A1r 2  18             clc
0002A2r 2  69 78          adc #$78                  ; $1E00 (screen) + $7800 = $9600 (colour)
0002A4r 2  85 FC          sta CHAR_PTR+1
0002A6r 2  AD 44 03       lda DRAW_COLOR
0002A9r 2  91 FB          sta (CHAR_PTR),y          ; colour RAM
0002ABr 2  60             rts
0002ACr 2               
0002ACr 2               ; Writes a null-terminated string across a row. Strings are stored as
0002ACr 2               ; screen codes (see the .charmap block in defs.asm), so the bytes go
0002ACr 2               ; straight into screen RAM. Colour comes from whatever ClearColors
0002ACr 2               ; last laid down.
0002ACr 2               ; In: TXT_PTR = string address, X = column, Y = row
0002ACr 2               PrintString:
0002ACr 2  20 rr rr       jsr CalcScreenPtr
0002AFr 2  A0 00          ldy #0                    ; Y indexes the string and the screen alike
0002B1r 2               @Loop:
0002B1r 2  B1 F9          lda (TXT_PTR),y
0002B3r 2  F0 05          beq @Done                 ; 0 terminates
0002B5r 2  91 FB          sta (CHAR_PTR),y
0002B7r 2  C8             iny
0002B8r 2  D0 F7          bne @Loop
0002BAr 2               @Done:
0002BAr 2  60             rts
0002BBr 2               
0002BBr 2               ; Computes a screen RAM pointer for a given cell into CHAR_PTR. Row
0002BBr 2               ; offsets are added SCREEN_COLS at a time since the screen (506 cells)
0002BBr 2               ; is too big to reach with a single 8-bit index register.
0002BBr 2               ; In: X = column (0-21), Y = row (0-22)
0002BBr 2               CalcScreenPtr:
0002BBr 2  A9 00          lda #<SCREEN
0002BDr 2  85 FB          sta CHAR_PTR
0002BFr 2  A9 1E          lda #>SCREEN
0002C1r 2  85 FC          sta CHAR_PTR+1            ; CHAR_PTR = $1E00 (screen RAM)
0002C3r 2               @RowLoop:
0002C3r 2  C0 00          cpy #0
0002C5r 2  F0 0F          beq @AddColumn
0002C7r 2  A5 FB          lda CHAR_PTR
0002C9r 2  18             clc
0002CAr 2  69 16          adc #SCREEN_COLS
0002CCr 2  85 FB          sta CHAR_PTR
0002CEr 2  90 02          bcc @NoCarry
0002D0r 2  E6 FC          inc CHAR_PTR+1            ; carry into the high byte
0002D2r 2               @NoCarry:
0002D2r 2  88             dey
0002D3r 2  4C rr rr       jmp @RowLoop
0002D6r 2               @AddColumn:
0002D6r 2  8A             txa
0002D7r 2  18             clc
0002D8r 2  65 FB          adc CHAR_PTR
0002DAr 2  85 FB          sta CHAR_PTR
0002DCr 2  90 02          bcc @Done
0002DEr 2  E6 FC          inc CHAR_PTR+1
0002E0r 2               @Done:
0002E0r 2  60             rts
0002E1r 2               
0002E1r 1               .include "chars.asm"         ; LoadCharacters and the glyph data
0002E1r 2               ;--------------------------------------------------------------------;
0002E1r 2               ; Characters - the character set                                      ;
0002E1r 2               ;--------------------------------------------------------------------;
0002E1r 2               
0002E1r 2               ; Points the VIC at $1C00 for its character set and fills it in.
0002E1r 2               ;
0002E1r 2               ; Pointing it away from ROM means the built-in font is gone, and we'd
0002E1r 2               ; have no letters to print with - so the first thing we do is copy the
0002E1r 2               ; ROM font's first 64 characters (screen codes 0-63: the letters, the
0002E1r 2               ; digits and punctuation) into RAM. Then we drop our own two glyphs
0002E1r 2               ; into slots 60 and 61, which would have been "<" and "=" - characters
0002E1r 2               ; no screen in this game ever prints.
0002E1r 2               LoadCharacters:
0002E1r 2  A9 FF          lda #$FF
0002E3r 2  8D 05 90       sta VIC_CR5               ; screen stays at $1E00, characters -> $1C00
0002E6r 2               
0002E6r 2  A9 00          lda #<CHARROM
0002E8r 2  85 F9          sta TXT_PTR
0002EAr 2  A9 80          lda #>CHARROM
0002ECr 2  85 FA          sta TXT_PTR+1             ; source: character ROM at $8000
0002EEr 2  A9 00          lda #$00
0002F0r 2  85 FB          sta CHAR_PTR
0002F2r 2  A9 1C          lda #$1C
0002F4r 2  85 FC          sta CHAR_PTR+1            ; destination: character RAM at $1C00
0002F6r 2               
0002F6r 2  A2 02          ldx #2                    ; two 256-byte pages = 64 characters
0002F8r 2               @PageLoop:
0002F8r 2  A0 00          ldy #0
0002FAr 2               @ByteLoop:
0002FAr 2  B1 F9          lda (TXT_PTR),y
0002FCr 2  91 FB          sta (CHAR_PTR),y
0002FEr 2  C8             iny
0002FFr 2  D0 F9          bne @ByteLoop
000301r 2  E6 FA          inc TXT_PTR+1
000303r 2  E6 FC          inc CHAR_PTR+1            ; on to the next page of each
000305r 2  CA             dex
000306r 2  D0 F0          bne @PageLoop
000308r 2               
000308r 2  A2 0F          ldx #CUSTOM_LEN-1
00030Ar 2               @CustomLoop:
00030Ar 2  BD rr rr       lda CustomChars,x
00030Dr 2  9D E0 1D       sta $1C00+CHAR_PLAYER*8,x ; overwrite slots 60 and 61
000310r 2  CA             dex
000311r 2  10 F7          bpl @CustomLoop
000313r 2  60             rts
000314r 2               
000314r 2               ; Eight bytes per character, one byte per row, one bit per pixel.
000314r 2               CustomChars:
000314r 2                 ; 60 - CHAR_PLAYER, the smiley
000314r 2  3C             .byte %00111100
000315r 2  7E             .byte %01111110
000316r 2  DB             .byte %11011011
000317r 2  FF             .byte %11111111
000318r 2  DB             .byte %11011011
000319r 2  E7             .byte %11100111
00031Ar 2  7E             .byte %01111110
00031Br 2  3C             .byte %00111100
00031Cr 2               
00031Cr 2                 ; 61 - CHAR_HAZARD, the deadly X
00031Cr 2  FF             .byte %11111111
00031Dr 2  BD             .byte %10111101
00031Er 2  DB             .byte %11011011
00031Fr 2  E7             .byte %11100111
000320r 2  E7             .byte %11100111
000321r 2  DB             .byte %11011011
000322r 2  BD             .byte %10111101
000323r 2  FF             .byte %11111111
000324r 2               CUSTOM_LEN = * - CustomChars
000324r 2               
000324r 1               
